  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4479a84d8ff7cb4384e6d46f28ffebf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BorununYolu.Ending.DedeKorkutNpc
  finalLayer: {fileID: 1450604826}
  backdrop: {fileID: 1450604827}
  lineBoxGroup: {fileID: 1311449675}
  lineBox: {fileID: 1834557716}
  endingScreen: {fileID: 641845896}
  dimAlpha: 0.6
  fadeInDuration: 1
  appearDuration: 1.2
  blackoutDuration: 0.8
  holdBeforeEnding: 0.5
  fadeOutDuration: 1.5
  displayName: Dede Korkut
  lines:
  - "Gel o\u011Ful Aybars, yolun uzun oldu. Oban\u0131n derdini r\xFCzgar bana \xE7oktan getirdi: ekin kurudu, p\u0131nar dindi."
  - "Suyu esirgeyen kurur, payla\u015Fan \xE7o\u011Fal\u0131r. Kuyunu kom\u015Fundan, sofran\u0131 yoksuldan sak\u0131nma; bereket payla\u015F\u0131lan sofraya iner."
  - "A\u011Fa\xE7 dikin, k\xF6k\xFC topra\u011F\u0131 tutsun. Toprak tutulursa ya\u011Fmur da geri d\xF6ner."
  - "Obana d\xF6n, ulu \xE7\u0131nar\u0131n dibinde ate\u015F yak, herkesi bir araya topla. G\xF6n\xFCller birle\u015Fince g\xF6k de yumu\u015Far."
  - "Haydi git yi\u011Fidim! B\xF6r\xFC'ye iyi bak; bulut senin ard\u0131ndan gelecek."
  ConversationStarted:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1492041157}
        m_TargetAssemblyTypeName: BorununYolu.World.PlayerLock, Assembly-CSharp
        m_MethodName: Lock
        m_Mode: 1
